{
  "$defs": {
    "Aspect": {
      "additionalProperties": false,
      "description": "The frame's proportions in each orientation; output presets give the pixel size.",
      "properties": {
        "landscape": {
          "examples": [
            "2:3",
            "3:4"
          ],
          "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$",
          "title": "Landscape",
          "type": "string"
        },
        "portrait": {
          "examples": [
            "2:3",
            "3:4"
          ],
          "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$",
          "title": "Portrait",
          "type": "string"
        }
      },
      "required": [
        "portrait",
        "landscape"
      ],
      "title": "Aspect",
      "type": "object"
    },
    "Band": {
      "additionalProperties": false,
      "description": "A solid strip flush with one edge of the frame, across its full length. Its\nthickness is a share of the frame's size across that edge (the height, for the top\nand bottom edges).",
      "properties": {
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "edge": {
          "enum": [
            "top",
            "bottom",
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "kind": {
          "const": "vector",
          "title": "Kind",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "overlapsWindow": {
          "default": false,
          "description": "Whether the layer may cover the photo window (DESIGN.md 4.4), as a caption bar over the photo or a flower over its corner does. If not, the window is cut through it.",
          "title": "Overlapswindow",
          "type": "boolean"
        },
        "shape": {
          "const": "band",
          "title": "Shape",
          "type": "string"
        },
        "thickness": {
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Thickness",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "shape",
        "edge",
        "thickness",
        "color"
      ],
      "title": "Band",
      "type": "object"
    },
    "Bar": {
      "additionalProperties": false,
      "description": "A strip parallel to one edge, at a distance from it (it may cross the window's\nedge, as in a caption bar). Distance and thickness are shares of the frame's size\nacross that edge.",
      "properties": {
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "distance": {
          "description": "From the edge to the bar's near side.",
          "maximum": 1,
          "minimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "edge": {
          "enum": [
            "top",
            "bottom",
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "kind": {
          "const": "vector",
          "title": "Kind",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "overlapsWindow": {
          "default": false,
          "description": "Whether the layer may cover the photo window (DESIGN.md 4.4), as a caption bar over the photo or a flower over its corner does. If not, the window is cut through it.",
          "title": "Overlapswindow",
          "type": "boolean"
        },
        "shape": {
          "const": "bar",
          "title": "Shape",
          "type": "string"
        },
        "thickness": {
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Thickness",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "shape",
        "edge",
        "distance",
        "thickness",
        "color"
      ],
      "title": "Bar",
      "type": "object"
    },
    "Box": {
      "additionalProperties": false,
      "description": "A rectangle from the frame's top-start corner: x and width are shares of the\nframe's width, y and height of its height.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Box",
      "type": "object"
    },
    "BrandKitStamp": {
      "additionalProperties": false,
      "description": "The workspace's stamp from its brand kit.",
      "properties": {
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "size": {
          "default": 0.08,
          "description": "Longest side, as a share of the frame's shorter side.",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Size",
          "type": "number"
        },
        "slot": {
          "oneOf": [
            {
              "enum": [
                "top-band",
                "bottom-band",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "under-headline",
                "start-edge",
                "end-edge"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SlotPerOrientation"
            }
          ],
          "title": "Slot"
        },
        "source": {
          "const": "brand-kit",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "source"
      ],
      "title": "BrandKitStamp",
      "type": "object"
    },
    "Date": {
      "additionalProperties": false,
      "properties": {
        "afterSunset": {
          "default": false,
          "description": "The event is in the evening, so its Hebrew date is the next day's.",
          "title": "Aftersunset",
          "type": "boolean"
        },
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "font": {
          "description": "A workspace font (font_…) or a built-in font by name: heebo-light, heebo, heebo-medium, heebo-bold, heebo-extrabold, heebo-black, rubik, rubik-bold, varela-round, secular-one, frank-ruhl-libre, frank-ruhl-libre-bold, david-libre, david-libre-bold, bellefair, suez-one, karantina, karantina-bold, amatic-sc, amatic-sc-bold, playpen-sans-hebrew, playpen-sans-hebrew-bold, playfair-display, playfair-display-bold, great-vibes.",
          "examples": [
            "heebo",
            "amatic-sc-bold"
          ],
          "maxLength": 40,
          "pattern": "^(font_[a-z2-7]{26}|[a-z0-9]+(-[a-z0-9]+)*)$",
          "title": "Font",
          "type": "string"
        },
        "formats": {
          "items": {
            "discriminator": {
              "mapping": {
                "gregorian": "#/$defs/GregorianFormat",
                "hebrew": "#/$defs/HebrewFormat"
              },
              "propertyName": "calendar"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GregorianFormat"
              },
              {
                "$ref": "#/$defs/HebrewFormat"
              }
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "joiner": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": " · ",
          "description": "Between formats on one line; null stacks them on separate lines.",
          "title": "Joiner"
        },
        "override": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text typed by hand, shown instead of the formats.",
          "title": "Override"
        },
        "size": {
          "description": "Largest text height, as a share of the frame's shorter side; the renderer shrinks the text to fit its slot.",
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "title": "Size",
          "type": "number"
        },
        "slot": {
          "oneOf": [
            {
              "enum": [
                "top-band",
                "bottom-band",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "under-headline",
                "start-edge",
                "end-edge"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SlotPerOrientation"
            }
          ],
          "title": "Slot"
        },
        "value": {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "font",
        "color",
        "size",
        "value",
        "formats",
        "slot"
      ],
      "title": "Date",
      "type": "object"
    },
    "Decoration": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "enum": [
            "stroke",
            "bar",
            "corners",
            "surround",
            "scatter",
            "template"
          ],
          "title": "Archetype",
          "type": "string"
        },
        "layers": {
          "description": "Drawn in order: the first is at the bottom.",
          "items": {
            "discriminator": {
              "mapping": {
                "piece": "#/$defs/Piece",
                "vector": {
                  "discriminator": {
                    "mapping": {
                      "band": "#/$defs/Band",
                      "bar": "#/$defs/Bar",
                      "ellipse": "#/$defs/Shape",
                      "rectangle": "#/$defs/Shape",
                      "stroke": "#/$defs/Stroke"
                    },
                    "propertyName": "shape"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Stroke"
                    },
                    {
                      "$ref": "#/$defs/Band"
                    },
                    {
                      "$ref": "#/$defs/Bar"
                    },
                    {
                      "$ref": "#/$defs/Shape"
                    }
                  ]
                }
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "discriminator": {
                  "mapping": {
                    "band": "#/$defs/Band",
                    "bar": "#/$defs/Bar",
                    "ellipse": "#/$defs/Shape",
                    "rectangle": "#/$defs/Shape",
                    "stroke": "#/$defs/Stroke"
                  },
                  "propertyName": "shape"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Stroke"
                  },
                  {
                    "$ref": "#/$defs/Band"
                  },
                  {
                    "$ref": "#/$defs/Bar"
                  },
                  {
                    "$ref": "#/$defs/Shape"
                  }
                ]
              },
              {
                "$ref": "#/$defs/Piece"
              }
            ]
          },
          "maxItems": 64,
          "title": "Layers",
          "type": "array"
        }
      },
      "required": [
        "archetype",
        "layers"
      ],
      "title": "Decoration",
      "type": "object"
    },
    "GregorianFormat": {
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "const": "gregorian",
          "title": "Calendar",
          "type": "string"
        },
        "locale": {
          "default": "he",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$",
          "title": "Locale",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[dMy .,/\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unicode date pattern: d or dd, M to MMMM, yy or yyyy, and separators.",
          "examples": [
            "dd.MM.yyyy",
            "d.M.yy",
            "d MMMM yyyy"
          ],
          "title": "Pattern"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "short",
                "medium",
                "long",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        }
      },
      "required": [
        "calendar"
      ],
      "title": "GregorianFormat",
      "type": "object"
    },
    "Headline": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "font": {
          "description": "A workspace font (font_…) or a built-in font by name: heebo-light, heebo, heebo-medium, heebo-bold, heebo-extrabold, heebo-black, rubik, rubik-bold, varela-round, secular-one, frank-ruhl-libre, frank-ruhl-libre-bold, david-libre, david-libre-bold, bellefair, suez-one, karantina, karantina-bold, amatic-sc, amatic-sc-bold, playpen-sans-hebrew, playpen-sans-hebrew-bold, playfair-display, playfair-display-bold, great-vibes.",
          "examples": [
            "heebo",
            "amatic-sc-bold"
          ],
          "maxLength": 40,
          "pattern": "^(font_[a-z2-7]{26}|[a-z0-9]+(-[a-z0-9]+)*)$",
          "title": "Font",
          "type": "string"
        },
        "size": {
          "description": "Largest text height, as a share of the frame's shorter side; the renderer shrinks the text to fit its slot.",
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "title": "Size",
          "type": "number"
        },
        "slot": {
          "oneOf": [
            {
              "enum": [
                "top-band",
                "bottom-band",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "under-headline",
                "start-edge",
                "end-edge"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SlotPerOrientation"
            }
          ],
          "title": "Slot"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "font",
        "color",
        "size",
        "text",
        "slot"
      ],
      "title": "Headline",
      "type": "object"
    },
    "HebrewFormat": {
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "const": "hebrew",
          "title": "Calendar",
          "type": "string"
        },
        "numerals": {
          "default": "hebrew",
          "enum": [
            "hebrew",
            "digits"
          ],
          "title": "Numerals",
          "type": "string"
        },
        "style": {
          "default": "day-month-year",
          "enum": [
            "day-month-year",
            "month-year",
            "year"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "calendar"
      ],
      "title": "HebrewFormat",
      "type": "object"
    },
    "ImageStamp": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "pattern": "^ast_[a-z2-7]{26}$",
          "title": "Image",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "size": {
          "default": 0.08,
          "description": "Longest side, as a share of the frame's shorter side.",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Size",
          "type": "number"
        },
        "slot": {
          "oneOf": [
            {
              "enum": [
                "top-band",
                "bottom-band",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "under-headline",
                "start-edge",
                "end-edge"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SlotPerOrientation"
            }
          ],
          "title": "Slot"
        },
        "source": {
          "const": "image",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "source",
        "image"
      ],
      "title": "ImageStamp",
      "type": "object"
    },
    "Insets": {
      "additionalProperties": false,
      "description": "Distances from the frame's edges to the window. `start` and `end` follow the\nreading direction (start is the right side in Hebrew).",
      "properties": {
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "end": {
          "maximum": 1,
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "start": {
          "maximum": 1,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "top": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "top",
        "bottom",
        "start",
        "end"
      ],
      "title": "Insets",
      "type": "object"
    },
    "Offset": {
      "additionalProperties": false,
      "description": "A move from the anchor: x towards the end (a share of the frame's width), y\ndownwards (a share of its height).",
      "properties": {
        "x": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Offset",
      "type": "object"
    },
    "Piece": {
      "additionalProperties": false,
      "description": "A raster artwork piece (with its own transparency), placed by anchor.",
      "properties": {
        "anchor": {
          "enum": [
            "top-start",
            "top",
            "top-end",
            "start",
            "center",
            "end",
            "bottom-start",
            "bottom",
            "bottom-end"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "kind": {
          "const": "piece",
          "title": "Kind",
          "type": "string"
        },
        "mirror": {
          "default": "none",
          "enum": [
            "none",
            "inline",
            "block"
          ],
          "title": "Mirror",
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/Offset",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "overlapsWindow": {
          "default": false,
          "description": "Whether the layer may cover the photo window (DESIGN.md 4.4), as a caption bar over the photo or a flower over its corner does. If not, the window is cut through it.",
          "title": "Overlapswindow",
          "type": "boolean"
        },
        "piece": {
          "pattern": "^pc_[a-z2-7]{26}$",
          "title": "Piece",
          "type": "string"
        },
        "rotate": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Rotate",
          "type": "number"
        },
        "size": {
          "description": "The piece's longer side, as a share of the frame's shorter side.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Size",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "piece",
        "anchor",
        "size"
      ],
      "title": "Piece",
      "type": "object"
    },
    "Shape": {
      "additionalProperties": false,
      "description": "A filled rectangle or ellipse. It is rotated about its box's centre; parts that a\nrotation takes past the frame are clipped.",
      "properties": {
        "box": {
          "$ref": "#/$defs/Box"
        },
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "kind": {
          "const": "vector",
          "title": "Kind",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "overlapsWindow": {
          "default": false,
          "description": "Whether the layer may cover the photo window (DESIGN.md 4.4), as a caption bar over the photo or a flower over its corner does. If not, the window is cut through it.",
          "title": "Overlapswindow",
          "type": "boolean"
        },
        "rotate": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Rotate",
          "type": "number"
        },
        "shape": {
          "enum": [
            "rectangle",
            "ellipse"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "shape",
        "box",
        "color"
      ],
      "title": "Shape",
      "type": "object"
    },
    "SlotPerOrientation": {
      "additionalProperties": false,
      "properties": {
        "landscape": {
          "enum": [
            "top-band",
            "bottom-band",
            "top-start",
            "top-end",
            "bottom-start",
            "bottom-end",
            "under-headline",
            "start-edge",
            "end-edge"
          ],
          "title": "Landscape",
          "type": "string"
        },
        "portrait": {
          "enum": [
            "top-band",
            "bottom-band",
            "top-start",
            "top-end",
            "bottom-start",
            "bottom-end",
            "under-headline",
            "start-edge",
            "end-edge"
          ],
          "title": "Portrait",
          "type": "string"
        }
      },
      "required": [
        "portrait",
        "landscape"
      ],
      "title": "SlotPerOrientation",
      "type": "object"
    },
    "Stroke": {
      "additionalProperties": false,
      "description": "A line around the window, or along the frame's outer edge. `offset` is the gap\nto what it surrounds: outwards from the window, inwards from the frame's edge. Width\nand offset are shares of the frame's shorter side. A window stroke that reaches past\nthe frame is clipped there.",
      "properties": {
        "around": {
          "default": "window",
          "enum": [
            "window",
            "frame"
          ],
          "title": "Around",
          "type": "string"
        },
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "kind": {
          "const": "vector",
          "title": "Kind",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "description": "Gap between the line and what it surrounds.",
          "maximum": 1,
          "minimum": 0,
          "title": "Offset",
          "type": "number"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "overlapsWindow": {
          "default": false,
          "description": "Whether the layer may cover the photo window (DESIGN.md 4.4), as a caption bar over the photo or a flower over its corner does. If not, the window is cut through it.",
          "title": "Overlapswindow",
          "type": "boolean"
        },
        "shape": {
          "const": "stroke",
          "title": "Shape",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "shape",
        "width",
        "color"
      ],
      "title": "Stroke",
      "type": "object"
    },
    "TextStamp": {
      "additionalProperties": false,
      "description": "A text stamp given here; its size is a text height, as for the headline.",
      "properties": {
        "color": {
          "examples": [
            "#c9a24a",
            "#00000080"
          ],
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "font": {
          "description": "A workspace font (font_…) or a built-in font by name: heebo-light, heebo, heebo-medium, heebo-bold, heebo-extrabold, heebo-black, rubik, rubik-bold, varela-round, secular-one, frank-ruhl-libre, frank-ruhl-libre-bold, david-libre, david-libre-bold, bellefair, suez-one, karantina, karantina-bold, amatic-sc, amatic-sc-bold, playpen-sans-hebrew, playpen-sans-hebrew-bold, playfair-display, playfair-display-bold, great-vibes.",
          "examples": [
            "heebo",
            "amatic-sc-bold"
          ],
          "maxLength": 40,
          "pattern": "^(font_[a-z2-7]{26}|[a-z0-9]+(-[a-z0-9]+)*)$",
          "title": "Font",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "size": {
          "description": "Largest text height, as a share of the frame's shorter side; the renderer shrinks the text to fit its slot.",
          "exclusiveMinimum": 0,
          "maximum": 0.25,
          "title": "Size",
          "type": "number"
        },
        "slot": {
          "oneOf": [
            {
              "enum": [
                "top-band",
                "bottom-band",
                "top-start",
                "top-end",
                "bottom-start",
                "bottom-end",
                "under-headline",
                "start-edge",
                "end-edge"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/SlotPerOrientation"
            }
          ],
          "title": "Slot"
        },
        "source": {
          "const": "text",
          "title": "Source",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "font",
        "color",
        "size",
        "slot",
        "source",
        "text"
      ],
      "title": "TextStamp",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "The one photo window. It is cut after every layer is drawn, so it is always fully\ntransparent (alpha 0) except where a layer is allowed to overlap it.",
      "properties": {
        "landscape": {
          "$ref": "#/$defs/WindowPlacement"
        },
        "mask": {
          "anyOf": [
            {
              "pattern": "^ast_[a-z2-7]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For 'mask': the asset whose alpha is the window's shape.",
          "title": "Mask"
        },
        "portrait": {
          "$ref": "#/$defs/WindowPlacement"
        },
        "radius": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Corner radius for 'rounded', as a share of the window's own shorter side: 0.5 makes the short sides fully round.",
          "title": "Radius"
        },
        "shape": {
          "enum": [
            "rectangle",
            "rounded",
            "arch",
            "oval",
            "mask"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "portrait",
        "landscape"
      ],
      "title": "Window",
      "type": "object"
    },
    "WindowPlacement": {
      "additionalProperties": false,
      "properties": {
        "inset": {
          "$ref": "#/$defs/Insets"
        }
      },
      "required": [
        "inset"
      ],
      "title": "WindowPlacement",
      "type": "object"
    }
  },
  "$id": "https://github.com/EladBarkay/orenew-framegen/schemas/frame-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One frame design. This schema checks each field. FrameGen also checks rules across fields that it cannot express: the window keeps at least 20% of the frame; bars, boxes, frame strokes and piece anchors stay inside the frame; portrait is not wider than tall; a radius only for 'rounded' and a mask only for 'mask'; each decoration archetype has its layers; and the headline, date and stamp each have their own slot in each orientation ('under-headline' needs a headline); a Gregorian date pattern shows at least one date field, each run of a letter being a whole field (d, dd, M to MMMM, yy, yyyy), and a Gregorian format has a pattern or a style, not both, in a locale Unicode CLDR has; a date is in 1900-2199; text shows at least one visible character and has no control, direction-override or unpaired surrogate characters.",
  "properties": {
    "aspect": {
      "$ref": "#/$defs/Aspect"
    },
    "date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Date"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decoration": {
      "$ref": "#/$defs/Decoration"
    },
    "headline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Headline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "specVersion": {
      "const": 1,
      "title": "Specversion",
      "type": "integer"
    },
    "stamp": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "brand-kit": "#/$defs/BrandKitStamp",
              "image": "#/$defs/ImageStamp",
              "text": "#/$defs/TextStamp"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BrandKitStamp"
            },
            {
              "$ref": "#/$defs/TextStamp"
            },
            {
              "$ref": "#/$defs/ImageStamp"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stamp"
    },
    "window": {
      "$ref": "#/$defs/Window"
    }
  },
  "required": [
    "specVersion",
    "aspect",
    "window",
    "decoration"
  ],
  "title": "FrameSpec",
  "type": "object"
}
