            "name": "invitation_id",
            "required": true,
            "schema": {
              "description": "The invitation's ID.",
              "maxLength": 40,
              "title": "Invitation Id",
              "type": "string"
            }
          },
          {
            "description": "The workspace's ID.",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
