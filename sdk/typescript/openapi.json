                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Accept Invitation",
        "tags": [
          "workspaces"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "The signed-in user.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
